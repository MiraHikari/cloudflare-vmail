{
  "name": "cloudflare-vmail",
  "version": "1.0.0",
  "description": "Privacy-focused email service monorepo with Astro and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:packages": "pnpm --filter \"./packages/*\" --parallel run dev",
    "dev:apps": "pnpm --filter \"./apps/*\" --parallel run dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:apps": "pnpm --filter \"./apps/*\" run build",
    "start": "pnpm --filter \"./apps/*\" --parallel run start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm --filter \"./apps/*\" cf-typegen && tsc --build",
    "type-check:watch": "tsc --build --watch",
    "verify": "pnpm format:check && pnpm lint:check && pnpm type-check && pnpm test && pnpm build",
    "clean": "pnpm -r run clean && rimraf dist .tsbuildinfo",
    "test": "pnpm -r run test",
    "deploy": "pnpm build && pnpm -r run deploy",
    "prepare": "pnpm build:packages && husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,astro,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.17.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "pnpm": {
    "overrides": {
      "rollup": "4.62.4"
    }
  }
}

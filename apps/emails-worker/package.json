{
	"name": "email-worker",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "pnpm cf-typegen && wrangler dev",
		"start": "wrangler dev",
		"build": "pnpm cf-typegen && tsc --build",
		"test": "vitest run",
		"deploy": "wrangler deploy",
		"log": "wrangler tail",
		"cf-typegen": "wrangler types --include-runtime=false",
		"clean": "rimraf dist .tsbuildinfo",
		"lint": "eslint . --fix",
		"lint:check": "eslint ."
	},
	"dependencies": {
		"database": "workspace:^",
		"nanoid": "^6.0.0",
		"postal-mime": "^2.7.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.1",
		"@cloudflare/workers-types": "^5.20260801.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.118.0"
	}
}

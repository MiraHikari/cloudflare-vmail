# Development Environment Configuration
# This file is used for local development only

# Development Mode Flag
DEV_MODE=true

# Mock Data Configuration
USE_MOCK_DATA=true
MOCK_EMAIL_COUNT=5

# Turnstile Configuration (disabled in dev)
TURNSTILE_SECRET=dev-secret
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Site Configuration
SITE_NAME="Vmail (Dev)"
SITE_DESCRIPTION="Development environment for Vmail"
JWT_SECRET=dev-jwt-secret-do-not-use-in-production
COOKIE_EXPIRES_IN_SECONDS=86400

# Mail Domain
MAIL_DOMAIN="example.com,test.local"

# Database (use local D1 or mock)
DB_BINDING=DB

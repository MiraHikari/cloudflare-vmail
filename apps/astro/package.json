{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm cf-typegen && astro dev",
    "start": "pnpm dev",
    "check": "pnpm cf-typegen && astro check",
    "build": "pnpm check && astro build",
    "test": "vitest run",
    "preview": "pnpm build && wrangler dev",

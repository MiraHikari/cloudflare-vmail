---
import { ArrowLeft, ChevronDown, List } from 'lucide-react'
import Layout from '@/layouts/Layout.astro'

interface Props {
  title: string
  description: string
  pageTitle: string
  lastUpdated?: string
  headings?: { depth: number; slug: string; text: string }[]
}

const { title, description, pageTitle, lastUpdated, headings = [] } = Astro.props

// Filter headings to only include h2 and h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

<Layout title={title} description={description}>
  <main class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:pb-24">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      <ArrowLeft className="size-4" />
      Back to home
    </a>

    <header class="mt-6 border-b border-border pb-8">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {pageTitle}
      </h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">{description}</p>
    </header>

    {/* Mobile TOC */}
    {
      tocHeadings.length > 0 && (
        <details
          class="group mt-6 rounded-lg border border-border bg-card lg:hidden"
          data-mobile-toc
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-2 p-4 text-sm font-medium text-foreground [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <List className="size-4" />
              On this page
            </span>
            <ChevronDown className="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
          </summary>
          <nav class="max-h-[60vh] overflow-y-auto border-t border-border p-4">
            <div class="space-y-1">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground',
                    heading.depth === 3 && 'pl-4',
                  ]}
                  data-toc-link
                  data-heading-id={heading.slug}
                >
                  <span class="line-clamp-2">{heading.text}</span>
                </a>
              ))}
            </div>
          </nav>
        </details>
      )
    }

    <div class="mt-8 grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-16">
      {/* Main Content */}
      <article class="min-w-0">
        <div class="prose">
          <slot />
        </div>

        {
          lastUpdated && (
            <p class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground">
              Last updated: {lastUpdated}
            </p>
          )
        }
      </article>

      {/* Desktop TOC */}
      {
        tocHeadings.length > 0 && (
          <aside class="hidden lg:block">
            <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
              <p class="mb-3 text-sm font-medium text-foreground">On this page</p>
              <div class="space-y-1 border-l border-border">
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class:list={[
                      '-ml-px block border-l-2 border-transparent py-1 pl-4 text-sm text-muted-foreground transition-colors hover:text-foreground',
                      heading.depth === 3 && 'pl-8',
                    ]}
                    data-toc-link
                    data-heading-id={heading.slug}
                  >
                    <span class="line-clamp-2">{heading.text}</span>
                  </a>
                ))}
              </div>
            </nav>
          </aside>
        )
      }
    </div>
  </main>
</Layout>

<script>
  function initDocsTOC() {
    const links = Array.from(document.querySelectorAll('[data-toc-link]'))
    if (links.length === 0) return

    // Smooth scroll with fixed-header offset, close mobile TOC after navigation
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const id = link.getAttribute('data-heading-id')
        const target = id ? document.getElementById(id) : null
        if (!id || !target) return

        const y = target.getBoundingClientRect().top + window.pageYOffset - 96
        window.scrollTo({ top: y, behavior: 'smooth' })
        history.pushState(null, '', `#${id}`)

        const details = link.closest('details')
        if (details) details.removeAttribute('open')
      })
    })

    // Highlight the active section while scrolling
    const headingIds = [...new Set(links.map((l) => l.getAttribute('data-heading-id')))]
    const headingElements = headingIds
      .map((id) => (id ? document.getElementById(id) : null))
      .filter((el): el is HTMLElement => el !== null)

    if (headingElements.length === 0) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const id = entry.target.id
          links.forEach((link) => {
            const isActive = link.getAttribute('data-heading-id') === id
            link.classList.toggle('text-foreground', isActive)
            link.classList.toggle('font-medium', isActive)
            link.classList.toggle('!border-primary', isActive)
            link.classList.toggle('text-muted-foreground', !isActive)
          })
        })
      },
      { rootMargin: '-100px 0px -66%', threshold: 0 }
    )

    headingElements.forEach((heading) => observer.observe(heading))
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDocsTOC)
  } else {
    initDocsTOC()
  }
</script>

<style>
  /* Offset anchor jumps below the fixed header */
  .prose :where(h1, h2, h3, h4, h5, h6) {
    scroll-margin-top: 6.5rem;
  }
</style>

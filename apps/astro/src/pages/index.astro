---
import type { EmailSummary } from 'database/dao'
import { actions } from 'astro:actions'
import { Info, Mail } from 'lucide-react'
import { DomainNoticeBanner } from '@/components/DomainNoticeBanner'
import GenerateNewMailboxForm from '@/components/GenerateNewMailboxForm.astro'
import Inbox from '@/components/Inbox'
import Information from '@/components/Information.astro'
import LoggedInMailboxForm from '@/components/LoggedInMailboxForm.astro'
import { MailboxAuth } from '@/components/MailboxAuth'
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty'
import { Separator } from '@/components/ui/separator'
import Layout from '@/layouts/Layout.astro'
import { getRuntimeBindings } from '@/lib/runtime'
import { readMailboxSession } from '@/lib/session'

const env = getRuntimeBindings()
const isDev = import.meta.env.DEV || env.DEV_MODE === 'true'

const savedMailbox = readMailboxSession(() => Astro.cookies.get('mailbox')?.json())

// Use mock data in development if enabled
const useMockData = isDev && env.USE_MOCK_DATA === 'true'

// Check if Turnstile is enabled
const isTurnstileEnabled = !isDev || env.TURNSTILE_SECRET !== 'dev-secret'

let mails: EmailSummary[] | null = null
let isClaimed = false

if (useMockData && savedMailbox?.mailbox) {
  // Import mock data generator
  const { generateMockEmails } = await import('@/lib/dev-mock')
  mails = generateMockEmails(Number.parseInt(env.MOCK_EMAIL_COUNT || '5'), savedMailbox.mailbox)
  isClaimed = false
} else if (savedMailbox?.mailbox) {
  mails = (await Astro.callAction(actions.getEmailsByMessageToWho, {}))?.data ?? null

  // Check if mailbox is claimed
  const claimedResult = await Astro.callAction(actions.isMailboxClaimed, {
    address: savedMailbox.mailbox,
  })
  isClaimed = claimedResult?.data || false
}

// Show dev mode banner in development
const showDevBanner = isDev
---

<Layout title={`Inbox - ${env.SITE_NAME}`} description={env.SITE_DESCRIPTION}>
  <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6">
    {/* Notices */}
    <div class="mb-6 flex flex-col gap-3">
      {
        showDevBanner && (
          <Alert>
            <Info />
            <AlertTitle>Development Mode</AlertTitle>
            <AlertDescription className="col-start-2">
              {useMockData ? 'Using mock data · ' : ''}
              Turnstile {isTurnstileEnabled ? 'enabled' : 'disabled'}
            </AlertDescription>
          </Alert>
        )
      }
      <DomainNoticeBanner client:only="react" />
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {/* Left Sidebar - Information & Mailbox Controls */}
      <div class="flex flex-col gap-6 lg:col-span-1">
        <Information />

        <Card>
          {
            !savedMailbox?.mailbox ? (
              <>
                <CardHeader>
                  <CardTitle>Get Started</CardTitle>
                  <CardDescription>
                    Create a new temporary mailbox or log in to an existing one.
                  </CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-5">
                  <GenerateNewMailboxForm />
                  <div class="flex items-center gap-3">
                    <Separator className="flex-1" />
                    <span class="text-xs text-muted-foreground">or</span>
                    <Separator className="flex-1" />
                  </div>
                  <MailboxAuth client:load />
                </CardContent>
              </>
            ) : (
              <>
                <CardHeader>
                  <CardTitle>{isClaimed ? 'Your Mailbox' : 'Temporary Mailbox'}</CardTitle>
                  <CardDescription>
                    {isClaimed
                      ? 'This mailbox is protected by your password.'
                      : 'Anyone with this address can read its emails.'}
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <LoggedInMailboxForm hasMails={(mails?.length || 0) >= 1} />
                </CardContent>
              </>
            )
          }
        </Card>
      </div>

      {/* Right Content - Inbox */}
      <div class="lg:col-span-2">
        <Card className="h-full min-h-[400px] lg:min-h-[600px]">
          {
            savedMailbox?.mailbox ? (
              <CardContent className="flex-1">
                <Inbox
                  mails={mails || []}
                  mailboxAddress={savedMailbox.mailbox}
                  isClaimed={isClaimed}
                  client:load
                />
              </CardContent>
            ) : (
              <Empty className="h-full">
                <EmptyHeader>
                  <EmptyMedia variant="icon">
                    <Mail />
                  </EmptyMedia>
                  <EmptyTitle>Welcome to {env.SITE_NAME}</EmptyTitle>
                  <EmptyDescription>
                    Create a temporary mailbox to receive emails instantly, or log in to your
                    claimed mailbox to access your messages.
                  </EmptyDescription>
                </EmptyHeader>
              </Empty>
            )
          }
        </Card>
      </div>
    </div>
  </main>
</Layout>

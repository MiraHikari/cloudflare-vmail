---
import type { Email } from 'database/schema'
import * as DAO from 'database/dao'
import { getCloudflareD1 } from 'database/db'
import { Inbox, KeyRound, Lock, MailX } from 'lucide-react'
import { EmailHeaders } from '@/components/EmailHeaders'
import { EmailViewer } from '@/components/EmailViewer'
import { OTPDisplay } from '@/components/OTPDisplay'
import PageHeader from '@/components/PageHeader.astro'
import { buttonVariants } from '@/components/ui/button'
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from '@/components/ui/empty'
import Layout from '@/layouts/Layout.astro'
import { authorizeMailboxSession } from '@/lib/mailbox-api'
import { extractOTP } from '@/lib/otp'
import { getRuntimeBindings } from '@/lib/runtime'
import { readMailboxSession } from '@/lib/session'

const { id } = Astro.params as { id: string }
const env = getRuntimeBindings()

const db = getCloudflareD1(env.DB)

let data: Email | null = null
let error: string | null = null
let isAuthorized = false
let otpCodes: string[] = []

// Get current mailbox session
const savedMailbox = readMailboxSession(() => Astro.cookies.get('mailbox')?.json())
if (!savedMailbox) error = 'Access denied: Invalid session'

try {
  // Check authorization first before fetching email data
  if (!savedMailbox) {
    error = 'Access denied: No mailbox session found'
  } else {
    try {
      await authorizeMailboxSession(db, savedMailbox.token, savedMailbox.mailbox, env.JWT_SECRET)

      // Get the email only after JWT verification
      data = await DAO.getEmail(db, id, savedMailbox.mailbox)
      if (!data) {
        error = 'Email not found'
      } else {
        isAuthorized = true
        const content = data.text || data.html || ''
        otpCodes = extractOTP(content)
      }
    } catch {
      error = 'Access denied: Invalid session'
    }
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to fetch email'
}
---

<Layout
  title={`${isAuthorized && data?.subject ? data.subject : 'Protected Email'} - ${env.SITE_NAME}`}
  description={env.SITE_DESCRIPTION}
>
  <PageHeader
    title={isAuthorized && data?.subject ? data.subject : 'Protected Email'}
    description={isAuthorized && data
      ? `From ${data.from.name} (${data.from.address})`
      : 'Email content is protected'}
    showBackButton={true}
    backUrl="/"
  />

  <main class="min-h-screen bg-background">
    <div class="mx-auto max-w-7xl px-6 py-8">
      {
        error && (
          <Empty className="min-h-[60vh] gap-6 rounded-lg border border-dashed border-border">
            {error.includes('Access denied') ? (
              <>
                <EmptyHeader>
                  <EmptyMedia variant="icon">
                    <Lock />
                  </EmptyMedia>
                  <EmptyTitle className="text-base">Email Protected</EmptyTitle>
                  <EmptyDescription>
                    This email can only be viewed by the owner of the temporary mailbox it was sent
                    to.
                  </EmptyDescription>
                </EmptyHeader>
                <EmptyContent>
                  <EmptyDescription>
                    Use the "Retrieve Mailbox" feature on the homepage and enter your saved Email ID
                    to restore access. Only the original mailbox owner can view protected content —
                    without your Email ID, the mailbox cannot be recovered.
                  </EmptyDescription>
                  <a href="/" class={buttonVariants()}>
                    <KeyRound />
                    Retrieve Mailbox
                  </a>
                </EmptyContent>
              </>
            ) : (
              <>
                <EmptyHeader>
                  <EmptyMedia variant="icon">
                    <MailX />
                  </EmptyMedia>
                  <EmptyTitle className="text-base">Email Not Found</EmptyTitle>
                  <EmptyDescription>{error}</EmptyDescription>
                </EmptyHeader>
                <EmptyContent>
                  <a href="/" class={buttonVariants({ variant: 'outline' })}>
                    <Inbox />
                    Back to Inbox
                  </a>
                </EmptyContent>
              </>
            )}
          </Empty>
        )
      }
      {
        !error && data && isAuthorized && (
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            {/* Left Column: OTP + Email Metadata (narrow on lg+) */}
            <div class="space-y-6 lg:col-span-1">
              {otpCodes.length > 0 && <OTPDisplay codes={otpCodes} client:load />}
              <EmailHeaders email={data} client:load />
            </div>

            {/* Right Column: Email Viewer (wide on lg+) */}
            <div class="lg:col-span-2">
              <EmailViewer email={data} client:only="react" />
            </div>
          </div>
        )
      }
    </div>
  </main>
</Layout>

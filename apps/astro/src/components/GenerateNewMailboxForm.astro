---
import { Turnstile } from '@marsidev/react-turnstile'
import { actions, isInputError } from 'astro:actions'
import { Info } from 'lucide-react'
import { SelectDomain } from '@/components/SelectDomain'
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert'
import { Button } from '@/components/ui/button'
import { Field, FieldDescription, FieldGroup, FieldLabel } from '@/components/ui/field'
import { Spinner } from '@/components/ui/spinner'
import { getAvailableDomains, getRuntimeBindings } from '@/lib/runtime'

const env = getRuntimeBindings()

const result = Astro.getActionResult(actions.generateNewMailbox)
const turnstileSiteKey = env.TURNSTILE_SITE_KEY
const mailDomains = getAvailableDomains(env)

// Check for action errors
const hasError = result && !result.data && result.error
const errorMessage = hasError
  ? isInputError(result.error)
    ? result.error.message
    : result.error?.message || 'Failed to create mailbox'
  : null

// Check if we're in development mode
const isDev = import.meta.env.DEV || env.DEV_MODE === 'true'
const isTurnstileEnabled = !isDev || env.TURNSTILE_SECRET !== 'dev-secret'
---

<form action={actions.generateNewMailbox} method="POST" data-mailbox-form>
  <FieldGroup>
    <Field>
      <FieldLabel>Domain</FieldLabel>
      {mailDomains.length > 0 && <SelectDomain domains={mailDomains} client:load />}
      <FieldDescription>Pick a domain for your new mailbox address.</FieldDescription>
    </Field>

    <Field>
      <FieldLabel>Bot Check</FieldLabel>
      {
        isTurnstileEnabled ? (
          <>
            <div class="h-[65px] overflow-hidden border border-border bg-muted/30 [&_iframe]:w-full!">
              <Turnstile siteKey={turnstileSiteKey} client:only="react" />
            </div>
            <FieldDescription>Complete the verification to create your mailbox.</FieldDescription>
          </>
        ) : (
          <>
            <Alert>
              <Info />
              <AlertDescription className="col-start-2">
                Turnstile is disabled in development mode.
              </AlertDescription>
            </Alert>
            <input type="hidden" name="cf-turnstile-response" value="dev-mode-bypass" />
          </>
        )
      }
    </Field>

    {
      errorMessage && (
        <Alert variant="destructive">
          <AlertTitle>{errorMessage}</AlertTitle>
          <AlertDescription>Please try again or refresh the page.</AlertDescription>
        </Alert>
      )
    }

    <Button type="submit" className="w-full" data-submit-btn>
      <span class="btn-text">Create New Mailbox</span>
      <span class="btn-loading hidden items-center gap-2">
        <Spinner />
        Creating...
      </span>
    </Button>
  </FieldGroup>
</form>

<script>
  // Handle form submission loading state
  const form = document.querySelector('[data-mailbox-form]')
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit-btn]')
  const btnText = submitBtn?.querySelector('.btn-text')
  const btnLoading = submitBtn?.querySelector('.btn-loading')

  form?.addEventListener('submit', () => {
    if (submitBtn && btnText && btnLoading) {
      submitBtn.disabled = true
      btnText.classList.add('hidden')
      btnLoading.classList.remove('hidden')
      btnLoading.classList.add('flex')
    }
  })
</script>

---
import { Icon } from 'astro-icon/components'

interface Feature {
  icon: string
  title: string
  description: string
  gradient: string
  iconColor: string
}

const features: Feature[] = [
  {
    icon: 'ic:twotone-shield',
    title: 'Privacy Enhanced',
    description: 'No registration required',
    gradient: 'from-green-500/20 to-emerald-500/10',
    iconColor: 'text-green-600 dark:text-green-400',
  },
  {
    icon: 'ic:twotone-timer',
    title: '1-Day Expiration',
    description: 'Automatic cleanup after 24h',
    gradient: 'from-blue-500/20 to-cyan-500/10',
    iconColor: 'text-blue-600 dark:text-blue-400',
  },
  {
    icon: 'ic:twotone-info',
    title: 'Multiple Domains',
    description: 'Choose your preferred domain',
    gradient: 'from-purple-500/20 to-violet-500/10',
    iconColor: 'text-purple-600 dark:text-purple-400',
  },
  {
    icon: 'logos:cloudflare-icon',
    title: 'Cloudflare Powered',
    description: 'Global edge network',
    gradient: 'from-orange-500/20 to-amber-500/10',
    iconColor: 'text-orange-600 dark:text-orange-400',
  },
]
---

<div class="bg-card border border-border rounded-xl shadow-sm overflow-hidden">
  <div class="p-6">
    <div class="flex items-center gap-3 mb-6">
      <div
        class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center ring-1 ring-primary/10"
      >
        <Icon name="mdi:email" class="w-5 h-5 text-primary" />
      </div>
      <div>
        <h2 class="text-lg font-semibold text-card-foreground">Virtual Temporary Email</h2>
        <p class="text-xs text-muted-foreground">Fast, secure, anonymous</p>
      </div>
    </div>

    <div class="space-y-3">
      {
        features.map((feature) => (
          <div class="group flex items-center gap-3 p-3 rounded-lg hover:bg-muted/50 transition-colors">
            <div
              class={`flex-shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br ${feature.gradient} flex items-center justify-center ring-1 ring-border/50 group-hover:scale-105 transition-transform`}
            >
              <Icon class={`w-5 h-5 ${feature.iconColor}`} name={feature.icon} />
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm text-card-foreground">{feature.title}</div>
              <div class="text-muted-foreground text-xs">{feature.description}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {/* Bottom accent bar */}
  <div class="h-1 bg-gradient-to-r from-primary/50 via-primary to-primary/50"></div>
</div>

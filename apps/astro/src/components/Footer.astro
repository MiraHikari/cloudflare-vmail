---
import { getRuntimeBindings } from '@/lib/runtime'

const env = getRuntimeBindings()
const year = new Date().getFullYear()
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between sm:px-6"
  >
    <p>
      © 2023-{year}
      {env.SITE_NAME} · Built by{' '}
      <a
        href="https://www.gcxstudio.cn"
        target="_blank"
        rel="noreferrer"
        class="font-medium text-foreground underline-offset-4 hover:underline"
      >
        MiraHikari
      </a>
    </p>
    <nav class="flex items-center gap-4">
      <a href="/docs/api-docs" class="transition-colors hover:text-foreground">Docs</a>
      <a href="/docs/privacy" class="transition-colors hover:text-foreground">Privacy</a>
      <a href="/docs/terms" class="transition-colors hover:text-foreground">Terms</a>
    </nav>
  </div>
</footer>

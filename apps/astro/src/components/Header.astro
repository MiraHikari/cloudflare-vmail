---
import { GitHubLogoIcon } from '@radix-ui/react-icons'
import { getRuntimeBindings } from '@/lib/runtime'
import { ModeToggle } from './ModeToggle'

const env = getRuntimeBindings()
---

<header
  class="fixed inset-x-0 top-0 z-50 h-14 border-b border-border bg-background/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-full max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-heading text-base font-semibold tracking-tight text-foreground"
    >
      <img src="/avatar.webp" alt="" class="size-6 rounded-full" />
      {env.SITE_NAME}
    </a>

    <nav class="ml-auto flex items-center gap-1">
      <a
        href="/docs/api-docs"
        class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        Docs
      </a>
      <a
        href="https://github.com/MiraHikari/cloudflare-vmail"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub repository"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-foreground"
      >
        <GitHubLogoIcon className="size-4" />
      </a>
      <ModeToggle client:load />
    </nav>
  </div>
</header>
